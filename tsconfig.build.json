{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./lib",
    "declaration": true,
    "declarationDir": "./lib/types",
    "noEmit": false,
    "isolatedModules": false,
    "allowImportingTsExtensions": false,
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": ["src/**/*"],
  "exclude": ["test/**/*", "node_modules", "lib"]
}
